<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Catálogo · Óptica</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>
    <%- include('partials/navbar', { active: 'catalogo' }) %>
        <main class="contenedor">
            <div class="titulo-box">CATÁLOGO</div>
            <% if (mensaje) { %>
                <p class="alerta">
                    <%= mensaje %>
                </p>
                <% } %>
                    <% if (error) { %>
                        <p class="alerta error">
                            <%= error %>
                        </p>
                        <% } %>
                            <div class="grid-principal sin-lateral-derecho">
                                <form class="filtros" method="get" action="/catalogo">
                                    <label for="f-orden">Ordenar por:</label><select id="f-orden" name="orden">
                                        <option value="precio_desc" <%=filtros.orden==='precio_desc' ? 'selected' : ''
                                            %>>Precio (descendente)</option>
                                        <option value="precio_asc" <%=filtros.orden==='precio_asc' ? 'selected' : '' %>
                                            >Precio (ascendente)</option>
                                        <option value="nombre_asc" <%=filtros.orden==='nombre_asc' ? 'selected' : '' %>
                                            >Nombre (A-Z)</option>
                                    </select>
                                    <label>Precio:</label>
                                    <div class="rango"><input type="number" min="0" step="0.01" name="precio_desde"
                                            placeholder="Desde" value="<%= filtros.precio_desde %>"><input type="number"
                                            min="0" step="0.01" name="precio_hasta" placeholder="Hasta"
                                            value="<%= filtros.precio_hasta %>"></div>
                                    <label for="f-color">Color:</label><select id="f-color" name="color">
                                        <% ['Todos','Verde','Rojo','Azul','Metálico','Negro'].forEach(color=> { %>
                                            <option <%=filtros.color===color ? 'selected' : '' %>><%= color %>
                                            </option>
                                            <% }) %>
                                    </select><button class="btn btn-block" type="submit">Aplicar filtros</button>
                                </form>
                                <section>
                                    <form class="buscar-bar" method="get" action="/catalogo"><input type="hidden"
                                            name="orden" value="<%= filtros.orden %>"><input type="hidden" name="color"
                                            value="<%= filtros.color %>"><input type="hidden" name="precio_desde"
                                            value="<%= filtros.precio_desde %>"><input type="hidden" name="precio_hasta"
                                            value="<%= filtros.precio_hasta %>"><input name="buscar"
                                            value="<%= filtros.buscar %>" placeholder="Buscar producto..."><button
                                            class="btn">BUSCAR</button></form>
                                    <% if (!productos.length) { %>
                                        <p class="mensaje-vacio">No se encontraron productos con esos filtros.</p>
                                        <% } %>
                                            <div class="productos-grid">
                                                <% productos.forEach(p=> { %><article class="producto-card">
                                                        <div class="producto-imagen"></div>
                                                        <div class="producto-precio">$<%= money(p.precio_unitario) %>
                                                        </div>
                                                        <div class="producto-nombre">
                                                            <%= p.nombre %>
                                                        </div>
                                                        <div class="producto-desc">
                                                            <%= p.descripcion || '' %> · Color: <%= p.color %>
                                                        </div>
                                                        <div class="producto-desc">Disponibles: <%=
                                                                p.cantidad_disponible %>
                                                        </div>
                                                        <form action="/carrito/agregar" method="post"><input
                                                                type="hidden" name="id_producto"
                                                                value="<%= p.id_producto %>"><button
                                                                class="btn btn-block" <%=p.cantidad_disponible <=0
                                                                ? 'disabled' : '' %>><%= p.cantidad_disponible <=0
                                                                    ? 'Sin stock' : 'Agregar al carrito' %></button>
                                                        </form>
                                                    </article>
                                                    <% }) %>
                                            </div>
                                </section>
                            </div>
        </main>
</body>

</html>