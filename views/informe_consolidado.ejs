<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Informe consolidado · Óptica</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>
    <%- include('partials/navbar', { active: 'consolidado' }) %>
        <main class="contenedor">
            <div class="titulo-box">INFORME CONSOLIDADO Y GRÁFICO</div>
            <form class="filtros filtros-linea" method="get" action="/informe-consolidado">
                <div><label>Fecha de inicio:</label><input type="date" name="fecha_inicio"
                        value="<%= filtros.fecha_inicio %>"></div>
                <div><label>Fecha final:</label><input type="date" name="fecha_final"
                        value="<%= filtros.fecha_final %>"></div>
                <div class="grow"><label>Cliente:</label><select name="id_cliente">
                        <option value="">Todos</option>
                        <% clientes.forEach(c=> { %><option value="<%= c.id_cliente %>"
                                <%=String(filtros.id_cliente)===String(c.id_cliente) ? 'selected' : '' %>><%= c.nombre%>
                            </option>
                            <% }) %>
                    </select></div><button class="btn">Aplicar</button><button class="btn btn-secundario"
                    name="exportar" value="csv">Exportar CSV</button>
            </form>
            <div class="grid-principal report-grid">
                <section>
                    <h3>Rendimiento de ventas por color</h3>
                    <div class="table-wrap">
                        <table class="informe">
                            <thead>
                                <tr>
                                    <th>Color</th>
                                    <th>Unidades vendidas</th>
                                    <th>Precio promedio</th>
                                    <th>Ingresos totales</th>
                                    <th>Inventario disponible</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% filas.forEach(f=> { %><tr>
                                        <td>
                                            <%= f.color %>
                                        </td>
                                        <td>
                                            <%= f.total_productos_vendidos %>
                                        </td>
                                        <td>$<%= money(f.promedio_precio) %>
                                        </td>
                                        <td>$<%= money(f.ingresos_totales) %>
                                        </td>
                                        <td>
                                            <%= f.productos_en_inventario %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% if (!filas.length) { %>
                        <p class="mensaje-vacio">No hay datos para el periodo seleccionado.</p>
                        <% } %>
                            <p><strong>Cliente:</strong>
                                <%= clienteSeleccionado ? clienteSeleccionado.nombre : 'Todos' %>
                            </p>
                </section>
                <section class="grafico-caja">
                    <h3>Unidades vendidas por color</h3>
                    <% const max=Math.max(1, ...filas.map(f=> Number(f.total_productos_vendidos))); filas.forEach(f => {
                        %><div class="bar-row"><span>
                                <%= f.color %>
                            </span>
                            <div class="bar-track">
                                <div class="bar"style="width:<%= Math.max(3, Number(f.total_productos_vendidos) / max * 100) %>%">
                                </div>
                            </div><strong>
                                <%= f.total_productos_vendidos %>
                            </strong>
                        </div>
                        <% }) %>
                            <% if (!filas.length) { %>
                                <p class="mensaje-vacio">Sin datos para graficar.</p>
                                <% } %>
                </section>
            </div>
        </main>
</body>

</html>