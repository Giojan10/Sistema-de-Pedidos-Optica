<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Óptica · Identificación</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>
  <main class="contenedor login">
    <section class="panel">
      <h2>Bienvenido/a</h2>
      <p>Selecciona tu usuario o regístrate para continuar al catálogo.</p>
      <% if (error) { %>
        <p class="alerta error">
          <%= error %>
        </p>
        <% } %>
          <form action="/identificarse" method="post">
            <label for="select-cliente">Cliente existente</label>
            <select id="select-cliente" name="id_cliente" required>
              <option value="">-- Selecciona --</option>
              <% clientes.forEach(c=> { %><option value="<%= c.id_cliente %>">
                  <%= c.nombre %> (<%= c.email || 'sin correo' %>)
                </option>
                <% }) %>
            </select>
            <button class="btn btn-block" type="submit">Continuar</button>
          </form>
          <hr>
          <form action="/clientes" method="post">
            <label for="nuevo-nombre">Registrarme como nuevo cliente</label>
            <input id="nuevo-nombre" type="text" name="nombre" placeholder="Nombre completo" required maxlength="160">
            <input type="email" name="email" placeholder="Correo electrónico">
            <button class="btn btn-secundario btn-block" type="submit">Registrarme y continuar</button>
          </form>
    </section>
  </main>
</body>

</html>