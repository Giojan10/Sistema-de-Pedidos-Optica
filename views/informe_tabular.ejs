<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Informe tabular · Óptica</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>
    <%- include('partials/navbar', { active: 'tabular' }) %>
        <main class="contenedor">
            <div class="titulo-box">INFORME TABULAR</div>
            <h2 class="center">Ventas</h2>
            <div class="grid-principal informe-layout">
                <section class="table-wrap">
                    <table class="informe">
                        <thead>
                            <tr>
                                <th>Id compra</th>
                                <th>Fecha</th>
                                <th>Comprador</th>
                                <th>Producto</th>
                                <th>Color</th>
                                <th>Cantidad</th>
                                <th>Precio compra</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% filas.forEach(f=> { %><tr>
                                    <td>
                                        <%= f.id_compra %>
                                    </td>
                                    <td>
                                        <%= String(f.fecha_compra).slice(0,10) %>
                                    </td>
                                    <td>
                                        <%= f.comprador_nombre %>
                                    </td>
                                    <td>
                                        <%= f.producto %>
                                    </td>
                                    <td>
                                        <%= f.color %>
                                    </td>
                                    <td>
                                        <%= f.cantidad %>
                                    </td>
                                    <td>$<%= money(f.precio_compra) %>
                                    </td>
                                    <td
                                        class="<%= f.estado_compra === 'Realizado' ? 'estado-realizado' : 'estado-pendiente' %>">
                                        <%= f.estado_compra %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% if (!filas.length) { %>
                        <p class="mensaje-vacio">No hay compras que coincidan con el filtro.</p>
                        <% } %>
                </section>
                <form class="filtros" method="get" action="/informe-tabular"><label>Precio total por línea:</label>
                    <div class="rango"><input type="number" min="0" step="0.01" name="precio_desde" placeholder="Desde"
                            value="<%= filtros.precio_desde %>"><input type="number" min="0" step="0.01"
                            name="precio_hasta" placeholder="Hasta" value="<%= filtros.precio_hasta %>"></div><label
                        for="color">Color:</label><select id="color" name="color">
                        <% ['Todos','Verde','Rojo','Azul','Metálico','Negro'].forEach(color=> { %><option
                                <%=filtros.color===color ? 'selected' : '' %>><%= color %>
                            </option>
                            <% }) %>
                    </select><button class="btn btn-block">Aplicar filtro</button><button
                        class="btn btn-secundario btn-block" name="exportar" value="csv">Exportar CSV</button>
                </form>
            </div>
        </main>
</body>

</html>