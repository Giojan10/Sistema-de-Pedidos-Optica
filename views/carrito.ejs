<!doctype html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Carrito · Óptica</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>
    <%- include('partials/navbar', { active: 'carrito' }) %>
        <main class="contenedor">
            <div class="titulo-box">CARRITO</div>
            <% if (mensaje) { %>
                <p class="alerta">
                    <%= mensaje %>
                </p>
                <% } %>
                    <% if (error) { %>
                        <p class="alerta error">
                            <%= error %>
                        </p>
                        <% } %>
                            <div class="grid-principal carrito-layout">
                                <section>
                                    <% if (!items.length) { %>
                                        <p class="mensaje-vacio">Tu carrito está vacío. Ve al catálogo para añadir
                                            productos.</p>
                                        <% } %>
                                            <div class="productos-grid">
                                                <% items.forEach(p=> { %><article class="producto-card">
                                                        <div class="producto-imagen"></div>
                                                        <div class="producto-precio">$<%= money(p.precio_unitario *
                                                                p.cantidad) %>
                                                        </div>
                                                        <div class="producto-nombre">
                                                            <%= p.nombre %>
                                                        </div>
                                                        <div class="producto-desc">
                                                            <%= p.descripcion || '' %> · Color: <%= p.color %>
                                                        </div>
                                                        <div class="cantidad-control">
                                                            <form action="/carrito/quitar" method="post"><input
                                                                    type="hidden" name="id_producto"
                                                                    value="<%= p.id_producto %>"><button
                                                                    aria-label="Quitar una unidad">−</button></form>
                                                            <span>Cantidad: <strong>
                                                                    <%= p.cantidad %>
                                                                </strong></span>
                                                            <form action="/carrito/agregar" method="post"><input
                                                                    type="hidden" name="id_producto"
                                                                    value="<%= p.id_producto %>"><input type="hidden"
                                                                    name="return_to" value="carrito"><button
                                                                    aria-label="Agregar una unidad">+</button></form>
                                                        </div>
                                                    </article>
                                                    <% }) %>
                                            </div>
                                </section>
                                <aside class="resumen-carrito">
                                    <h3>Precio total:</h3>
                                    <div class="total">$<%= money(total) %>
                                    </div>
                                    <form action="/carrito/confirmar" method="post"><button class="btn btn-block"
                                            <%=!items.length ? 'disabled' : '' %>>Confirmar compra</button></form>
                                    <form action="/carrito/cancelar" method="post"><button
                                            class="btn btn-secundario btn-block" <%=!items.length ? 'disabled' : ''
                                            %>>Cancelar compra</button></form>
                                </aside>
                            </div>
        </main>
</body>

</html>